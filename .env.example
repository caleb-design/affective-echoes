# Affective Echoes settings. Copy this file to .env and change what you need.
# By default the built-in model (Llama 3.2 3B, runs on this computer) is used. No key needed.

# AE_LLM=auto            # auto | local | cloud | off
# AE_LLM_BACKEND=cpu     # force the processor if the graphics card causes trouble
# AE_MODEL_PATH=C:\models\other-model.gguf

# Only for AE_LLM=cloud (or auto without the built-in model):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# PORT=8000
